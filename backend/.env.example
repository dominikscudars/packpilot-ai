# Explicit local development. Never use AUTH_MODE=local in production.
NODE_ENV=development
AUTH_MODE=local
DATABASE_URL="file:./dev.db"
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ALLOWED_ORIGINS=http://localhost:5173

# For a separately configured Supabase environment, use AUTH_MODE=supabase
# and set the real HTTPS project origin. No service-role or signing secret is needed.
# SUPABASE_URL=https://your-project-ref.supabase.co
