# Frontend public configuration. Copy to .env.local; never put secrets in VITE_*.
# Without Supabase settings, only the explicitly selected local demo is available.
VITE_API_URL=http://localhost:3001
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_client_key
# Optional: where "Open Google Apps Script" on /survey links (https only; default https://script.new).
# VITE_GOOGLE_FORMS_SCRIPT_URL=https://script.google.com/...
